<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  InfEditor 的 Windows 应用清单。

  为什么必须嵌入：
  1. Common-Controls v6 —— 没有这条依赖，Win32 公共对话框（打开/另存为）和
     消息框会用旧版 comctl32 渲染：无视觉样式，在 DPI 缩放屏幕上发糊。
     这就是"另存为窗口是糊的"的根因。
  2. dpiAwareness PerMonitorV2 —— 在进程启动那一刻就锁定感知级别（比任何
     运行时 API 调用都早），主窗口与所有系统对话框共用同一套坐标语义。
  3. longPathAware —— 允许打开/保存超过 260 字符的路径（配合系统长路径开关）。
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="0.1.0.0" processorArchitecture="*" name="InfEditor" type="win32"/>
  <description>InfEditor 文本编辑器</description>

  <!-- 视觉样式：现代主题的公共控件（打开/另存为/消息框） -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0" processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>

  <!-- 普通用户权限，不触发 UAC 提权 -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- 声明支持的 Windows 版本（Win10/11） -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
